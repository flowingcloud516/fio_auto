; ILLUSTRATION ONLY: hypothetical disk capacity 1 TB (1,000,000,000,000 bytes).
; Regenerate with fio_excel_runner.py for your actual disk and CPU range.
; Do not run this static example against an arbitrary device.

; Generated by fio_excel_runner. Independent jobs use disjoint regions.
; Total disk range: 0%-84%; capacity=1000000000000 bytes.
; Clones created by numjobs share their parent job's region.
[global]
filename=/dev/nvme1n1
direct=1
ioengine=libaio
group_reporting=1
norandommap=1
randrepeat=0
ramp_time=0
time_based=1
allow_file_create=0
exitall_on_error=1
runtime=60

[job_001]
; Nominal disk range: [0%, 21%). End is exclusive.
; Aligned byte range: [0, 209999998976); size=209999998976 bytes.
offset=0
size=209999998976
rw=randread
bs=4096
iodepth=32
numjobs=2
cpus_allowed=2-3
cpus_allowed_policy=split

[job_002]
; Nominal disk range: [21%, 42%). End is exclusive.
; Aligned byte range: [209999998976, 419999997952); size=209999998976 bytes.
offset=209999998976
size=209999998976
rw=randread
bs=4096
iodepth=32
numjobs=2
cpus_allowed=4-5
cpus_allowed_policy=split

[job_003]
; Nominal disk range: [42%, 63%). End is exclusive.
; Aligned byte range: [419999997952, 629999996928); size=209999998976 bytes.
offset=419999997952
size=209999998976
rw=randread
bs=4096
iodepth=32
numjobs=2
cpus_allowed=6-7
cpus_allowed_policy=split

[job_004]
; Nominal disk range: [63%, 84%). End is exclusive.
; Aligned byte range: [629999996928, 840000000000); size=210000003072 bytes.
offset=629999996928
size=210000003072
rw=randread
bs=4096
iodepth=32
numjobs=2
cpus_allowed=8-9
cpus_allowed_policy=split
