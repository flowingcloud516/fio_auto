; ILLUSTRATION ONLY: hypothetical disk capacity 100 GiB (107,374,182,400 bytes).
; Regenerate with fio_excel_runner.py for your actual disk and CPU range.
; Do not run this static example against an arbitrary device.

; Generated by fio_excel_runner. Independent jobs use disjoint regions.
; Total disk range: 0%-84%; capacity=107374182400 bytes.
; Clones created by numjobs share their parent job's region.
[global]
filename=/dev/nvme1n1
direct=1
ioengine=libaio
group_reporting=1
norandommap=1
randrepeat=0
ramp_time=0
time_based=1
allow_file_create=0
exitall_on_error=1
runtime=60

[job_001]
; Nominal disk range: [0%, 42%). End is exclusive.
; Aligned byte range: [0, 45097156608); size=45097156608 bytes.
offset=0
size=42%
rw=randread
bs=4096
iodepth=32
numjobs=2
cpus_allowed=2-3
cpus_allowed_policy=split

[job_002]
; Nominal disk range: [42%, 84%). End is exclusive.
; Aligned byte range: [45097156608, 90194313216); size=45097156608 bytes.
offset=42%
size=42%
rw=randread
bs=4096
iodepth=32
numjobs=2
cpus_allowed=16-17
cpus_allowed_policy=split
